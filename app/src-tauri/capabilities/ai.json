{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-ai-review",
  "description": "Local model chat and review records for the bundled main webview",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "allow-ai-targets",
    "allow-ai-models",
    "allow-ai-select",
    "allow-ai-chat",
    "allow-ai-propose",
    "allow-ai-cancel-proposal",
    "allow-ai-decide",
    "allow-ai-decisions",
    "allow-ai-cli-review",
    "allow-ai-policy",
    "allow-ai-set-policy",
    "allow-ai-session-selection",
    "allow-ai-session-select",
    "allow-ai-session-confirm",
    "allow-ai-session-clear"
  ]
}
