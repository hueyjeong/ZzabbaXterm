{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-terminal",
  "description": "Local terminal commands for the bundled main webview",
  "local": true,
  "webviews": [
    "main"
  ],
  "permissions": [
    "allow-terminal-open",
    "allow-terminal-start",
    "allow-terminal-input",
    "allow-terminal-resize",
    "allow-terminal-ack",
    "allow-terminal-close",
    "allow-elevation-open",
    "allow-elevation-open-remote"
  ]
}
