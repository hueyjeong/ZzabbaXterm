{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-editor",
  "description": "Local editor commands for the bundled main webview",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "allow-editor-local-open",
    "allow-editor-local-save",
    "allow-editor-local-compare",
    "allow-editor-local-reload",
    "allow-editor-local-close"
  ]
}
